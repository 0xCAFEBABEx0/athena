{
  "schedules": {
    "payload-jobs": {
      "schedule": "0 * * * *",
      "path": "/api/payload-jobs/run",
      "requestMethod": "GET"
    }
  },
  "functions": {
    "src/app/(payload)/api/[...slug]/route.ts": {
      "maxDuration": 30
    },
    "src/app/(payload)/api/translate/route.ts": {
      "maxDuration": 300
    }
  },
  "build": {
    "env": {
      "NODE_VERSION": "24.22.1"
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"preview\" ] && git log -1 --pretty=%s | grep -qE '^Merge pull request #[0-9]+ from [^ ]+/preview$'; then exit 0; fi; exit 1",
  "env": {
    "NODE_ENV": "production"
  }
}
