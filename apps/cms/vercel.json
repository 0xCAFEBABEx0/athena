{
  "bunVersion": "1.4.x",
  "schedules": {
    "payload-jobs": {
      "schedule": "0 * * * *",
      "path": "/api/payload-jobs/run",
      "requestMethod": "GET"
    }
  },
  "functions": {
    "src/app/(payload)/api/[...slug]/route.ts": {
      "maxDuration": 60
    },
    "src/app/(payload)/api/translate/route.ts": {
      "maxDuration": 300
    }
  },
  "build": {
    "env": {
      "NODE_VERSION": "24.22.1"
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview": true
    }
  },
  "buildCommand": "bun run build",
  "ignoreCommand": "bash ../../scripts/vercel-ignore-build.sh",
  "env": {
    "NODE_ENV": "production"
  }
}
