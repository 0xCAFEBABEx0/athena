# Copy to apps/web/.env. Meanings: apps/web/README.md, docs/API.md §5.
CMS_URL=http://localhost:3000
WEB_URL=http://localhost:4321
# Shared with apps/cms/.env (same values there).
PREVIEW_SECRET=
REVALIDATE_SECRET=
# web-frontend service account key (draft preview); see
# apps/cms/src/scripts/create-web-service-account.ts
PAYLOAD_API_KEY=
# Optional
CMS_PROTECTION_BYPASS=
# Ask AI: ANTHROPIC_API_KEY, or ANTHROPIC_BASE_URL + CF_AIG_TOKEN for Cloudflare AI Gateway (docs/AI_SEARCH.md)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CF_AIG_TOKEN=
