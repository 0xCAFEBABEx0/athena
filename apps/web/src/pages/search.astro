---
import Layout from '@/layouts/Layout.astro'
import PostList from '@/components/PostList.astro'
import Prompt from '@/components/Prompt.astro'
import SearchPrompt from '@/components/SearchPrompt.astro'
import { searchPosts } from '@/lib/cms'
import { routeMeta } from '@/lib/seo'
import { getSite } from '@/lib/site'

const site = await getSite(Astro.request)
const query = (Astro.url.searchParams.get('q') ?? '').trim()
const results = await searchPosts(query)
const meta = routeMeta('検索', '/search', site)

// A blank query lists everything; the command line shows what ran.
const command = query ? `grep -ri "${query}" posts/` : 'ls posts'
---

<Layout meta={meta}>
  <div class="container pt-10">
    <h1 class="sr-only">記事を検索</h1>
    <SearchPrompt value={query} autofocus={!query} />
    <div class="mt-10">
      <Prompt command={command} heading={query ? '検索結果' : '記事'} count={results.totalDocs} />
      {
        results.docs.length > 0 ? (
          <PostList class="mt-1.5" posts={results.docs} />
        ) : (
          <p class="mt-2 pl-5 font-mono text-sm text-base-content/60">⎿ 見つかりませんでした</p>
        )
      }
    </div>
  </div>
</Layout>
