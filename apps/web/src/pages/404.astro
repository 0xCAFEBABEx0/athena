---
import Layout from '@/layouts/Layout.astro'
import Prompt from '@/components/Prompt.astro'
import SearchPrompt from '@/components/SearchPrompt.astro'
import { routeMeta } from '@/lib/seo'
import { getSite } from '@/lib/site'
import { isDraft } from '@/lib/draft'
import { dict, localeOf, localizePath, splitLocale } from '@/lib/i18n'

const locale = localeOf(Astro)
const t = dict(locale)
const lp = (path: string) => localizePath(locale, path)
const site = await getSite(Astro.locals, locale)
const meta = routeMeta('404', Astro.originPathname, site)
const path = lp(splitLocale(Astro.originPathname).path)

Astro.response.status = 404
// Keep the answer at the CDN (tagged `content`, so a publish that adds the
// page clears it): repeated hits on a missing URL then cost no function run
// and no CMS requests. Drafts are never cached (Layout.astro).
if (!isDraft(Astro.cookies)) {
  Astro.response.headers.set('Vercel-CDN-Cache-Control', 'public, max-age=86400')
}
---

<Layout meta={meta}>
  <div class="container pt-12">
    <Prompt command={`cd ${path}`} />
    <h1 class="mt-3 font-mono text-sm">
      <span class="text-error" aria-hidden="true">●</span> {t.notFoundTitle}
      <span class="text-base-content/65">(404)</span>
    </h1>
    <p class="mt-1 flex gap-2 pl-5 text-base-content/85">
      <span class="font-mono text-base-content/65" aria-hidden="true">⎿</span>
      {t.notFoundBody}
    </p>
    <p class="mt-4 pl-5 font-mono text-sm">
      <a class="link-term" href={lp('/')}>{t.backHome}</a> ·
      <a class="link-term" href={lp('/posts')}>{t.allPosts}</a>
    </p>
    <SearchPrompt class="mt-10" />
  </div>
</Layout>
