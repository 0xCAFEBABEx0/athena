---
/**
 * Standalone 500 page — do not import Layout/Header/Footer. Those fetch the
 * CMS, and a CMS failure is the usual reason we landed here.
 */
import '@fontsource/geist-sans/400.css'
import '@fontsource/geist-sans/600.css'
import '@fontsource/geist-mono/400.css'
import '@/styles/global.css'

import { LANG_TAG, dict, localizePath, splitLocale } from '@/lib/i18n'
import { DEFAULT_SITE_NAME } from '@/lib/site'

type Props = {
  error?: unknown
}

const { error } = Astro.props as Props
const message = error instanceof Error ? error.message : undefined
const isDev = import.meta.env.DEV

Astro.response.status = 500
// The middleware may not have run (it can be what failed), so read the URL.
const locale = Astro.locals.locale ?? splitLocale(Astro.originPathname).locale
const t = dict(locale)
---

<!doctype html>
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error | {DEFAULT_SITE_NAME}</title>
    <link href="/favicon.ico" rel="icon" sizes="32x32" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <script is:inline>
      ;(function () {
        var theme = 'light'
        try {
          var stored = window.localStorage.getItem('payload-theme')
          if (stored === 'light' || stored === 'dark') theme = stored
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark'
        } catch (_err) {
          /* ignore */
        }
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    <main class="container pt-12">
      <p class="font-mono text-sm text-base-content/60">
        <span class="text-primary" aria-hidden="true">❯</span> render {Astro.originPathname}
      </p>
      <h1 class="mt-3 font-mono text-sm">
        <span class="text-error" aria-hidden="true">●</span> {t.errorTitle}
        <span class="text-base-content/60">(500)</span>
      </h1>
      <p class="mt-1 flex gap-2 pl-5 text-base-content/85">
        <span class="font-mono text-base-content/60" aria-hidden="true">⎿</span>
        {t.errorBody}
      </p>
      {
        isDev && message && (
          <pre class="mt-6 w-full whitespace-pre-wrap break-words rounded-box border border-base-300 bg-base-200 p-4 font-mono text-[13px] text-base-content/80">
            {message}
          </pre>
        )
      }
      <p class="mt-4 pl-5 font-mono text-sm">
        <a class="link-term" href={localizePath(locale, '/')}>{t.backHome}</a>
      </p>
    </main>
  </body>
</html>
