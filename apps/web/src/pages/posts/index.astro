---
import { dict, localeOf, localizePath } from '@/lib/i18n'
import Layout from '@/layouts/Layout.astro'
import PostsArchive from '@/components/PostsArchive.astro'
import { getPosts } from '@/lib/cms'
import { routeMeta } from '@/lib/seo'
import { getSite } from '@/lib/site'

const locale = localeOf(Astro)
const t = dict(locale)
const lp = (path: string) => localizePath(locale, path)
const [site, posts] = await Promise.all([
  getSite(Astro.locals, locale),
  getPosts({ page: 1 }, { locale }),
])
const meta = routeMeta(t.allPosts, lp('/posts'), site, t.postsDescription(site.siteName))
---

<Layout meta={meta}>
  <PostsArchive posts={posts} />
</Layout>
