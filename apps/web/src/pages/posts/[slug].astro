---
import type { Post } from '@athena/shared/payload-types'
import type { SerializedEditorState } from '@payloadcms/richtext-lexical/lexical'

import Layout from '@/layouts/Layout.astro'
import PostHero from '@/components/heros/PostHero.astro'
import RelatedPosts from '@/components/blocks/RelatedPosts.astro'
import RichText from '@/components/RichText.astro'
import { getAdjacentPosts, getPost } from '@/lib/cms'
import { isDraft } from '@/lib/draft'
import { readingMinutes } from '@/lib/format'
import { richTextToHTML } from '@/lib/richtext'
import { buildMeta } from '@/lib/seo'
import { getSite } from '@/lib/site'

const draft = isDraft(Astro.cookies)
const slug = Astro.params.slug ?? ''
const post = await getPost(slug, { draft })

if (!post) {
  return Astro.rewrite('/404')
}

const site = await getSite(Astro.request)

const relatedPosts = (post.relatedPosts ?? []).filter(
  (related): related is Post => typeof related === 'object' && related !== null,
)

let adjacent: { prev: Post | null; next: Post | null } = { prev: null, next: null }
if (post.publishedAt) {
  try {
    adjacent = await getAdjacentPosts(post.publishedAt)
  } catch (error) {
    console.error('[post] failed to load adjacent posts', error)
  }
}

const content = post.content as unknown as SerializedEditorState
const plainText = content ? richTextToHTML(content).replace(/<[^>]+>/g, ' ') : ''
const meta = buildMeta(post, `/posts/${slug}`, site)
---

<Layout meta={meta}>
  <article class="container pb-4">
    <PostHero post={post} readingMinutes={readingMinutes(plainText)} />
    <RichText class="mt-9" data={content} enableGutter={false} />
  </article>

  <div class="container">
    {relatedPosts.length > 0 && <RelatedPosts class="mt-12" docs={relatedPosts} />}

    <nav class="mt-12 border-t border-base-300 pt-4 font-mono text-sm leading-loose" aria-label="前後の記事">
      {
        adjacent.prev && (
          <p class="flex gap-3">
            <span class="w-14 shrink-0 text-base-content/60">← prev</span>
            <a class="link-term font-sans text-[15px]" href={`/posts/${adjacent.prev.slug}`}>
              {adjacent.prev.title}
            </a>
          </p>
        )
      }
      {
        adjacent.next && (
          <p class="flex gap-3">
            <span class="w-14 shrink-0 text-base-content/60">next →</span>
            <a class="link-term font-sans text-[15px]" href={`/posts/${adjacent.next.slug}`}>
              {adjacent.next.title}
            </a>
          </p>
        )
      }
      <p class="flex gap-3">
        <span class="w-14 shrink-0 text-base-content/60">↑</span>
        <a class="link-term" href="/posts">すべての記事</a>
      </p>
    </nav>
  </div>
</Layout>
