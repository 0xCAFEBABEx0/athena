---
import Layout from '@/layouts/Layout.astro'
import PostsArchive from '@/components/PostsArchive.astro'
import { getPosts } from '@/lib/cms'
import { routeMeta } from '@/lib/seo'
import { getSite } from '@/lib/site'

const pageNumber = Number(Astro.params.pageNumber)

if (!Number.isInteger(pageNumber) || pageNumber < 1) {
  return Astro.rewrite('/404')
}

if (pageNumber === 1) {
  return Astro.redirect('/posts', 301)
}

const posts = await getPosts({ page: pageNumber })

if (posts.totalPages > 0 && pageNumber > posts.totalPages) {
  return Astro.rewrite('/404')
}

const site = await getSite(Astro.request)
const meta = routeMeta(`記事一覧（${pageNumber}ページ目）`, `/posts/page/${pageNumber}`, site)
---

<Layout meta={meta}>
  <PostsArchive posts={posts} />
</Layout>
