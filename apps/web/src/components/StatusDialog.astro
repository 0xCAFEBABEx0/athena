---
/**
 * `/status` panel: a terminal-style settings sheet with the site version,
 * build, cache state and the visitor's current settings. Opens from the
 * version next to the site name, the `s` key, or `/status` in the popup
 * search. Text follows the page language; switch values (CLI / ADE,
 * Light / Dark, EN / JP / ZH, true / false) stay English, like the switches.
 */
import { BUILD } from '@/lib/build'
import { LOCALES, LOCALE_LABEL, LOCALE_NAME, localeOf, localizePath, splitLocale, statusText } from '@/lib/i18n'
import type { SiteData } from '@/lib/site'

type Props = {
  site: SiteData
}

const { site } = Astro.props
const locale = localeOf(Astro)
const s = statusText(locale)
const en = statusText('en')
const current = splitLocale(Astro.originPathname).path
const renderedAt = new Date().toISOString()
const builtAt = `${BUILD.builtAt.slice(0, 16).replace('T', ' ')} UTC`

const tabs = (['status', 'config', 'keys'] as const).map((id) => ({ id, label: s.tabs[id] }))

// Config rows: each one is a setting stored in this browser only.
const langIndex = LOCALES.indexOf(locale)
const nextLocale = LOCALES[(langIndex + 1) % LOCALES.length] ?? locale
const settings = (['view', 'language', 'theme', 'motion', 'keys', 'reset'] as const).map((id) => {
  const [label, hint] = s.settings[id]
  // Search matches the English words too ("theme" finds テーマ).
  const search = [label, hint, ...en.settings[id]].join(' ').toLowerCase()
  return { id, label, hint, search }
})

const keys: [string, string][] = [
  ['/  ⌘K', s.keys.search],
  ['j  k', s.keys.move],
  ['t', s.keys.theme],
  ['v', s.keys.view],
  ['s', s.keys.panel],
  ['esc', s.keys.close],
]
---

<dialog
  class="modal items-start pt-[10vh] sm:pt-[14vh]"
  aria-labelledby="status-title"
  data-status-dialog
  data-index-url={localizePath(locale, '/search-index.json')}
  data-strings={JSON.stringify(s.client)}
>
  <div
    class="status-box modal-box w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-2xl border border-base-300 p-0 font-mono text-[13px] shadow-2xl"
  >
    <div class="flex flex-wrap items-center gap-x-1 gap-y-2 px-5 pb-3 pt-4" role="tablist" aria-label={s.panel}>
      <h2 id="status-title" class="me-2 text-[13px] font-semibold text-primary sm:me-3">{s.title}</h2>
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`status-tab-${tab.id}`}
            aria-controls={`status-panel-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            class="status-tab"
            data-status-tab={tab.id}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="max-h-[min(60vh,26rem)] overflow-y-auto px-5 pb-4">
      <section id="status-panel-status" role="tabpanel" aria-labelledby="status-tab-status" data-status-panel="status">
        <dl class="status-grid">
          <dt>{s.rows.site}</dt>
          <dd>{site.siteName}</dd>
          <dt>{s.rows.version}</dt>
          <dd>v{BUILD.version}</dd>
          <dt>{s.rows.commit}</dt>
          <dd>{BUILD.commit || 'unknown'}</dd>
          <dt>{s.rows.environment}</dt>
          <dd>{BUILD.env}</dd>
          <dt>{s.rows.built}</dt>
          <dd>{builtAt}</dd>
          <dt>{s.rows.rendered}</dt>
          <dd><time datetime={renderedAt} data-status-rendered>{renderedAt}</time></dd>
          <dt>{s.rows.cache}</dt>
          <dd>ISR · tag <code>content</code> · ttl 7d</dd>
        </dl>
        <dl class="status-grid mt-4">
          <dt>{s.rows.language}</dt>
          <dd>{LOCALE_LABEL[locale]} <span class="text-base-content/65">({LOCALE_NAME[locale]})</span></dd>
          <dt>{s.rows.view}</dt>
          <dd data-status-view>CLI</dd>
          <dt>{s.rows.theme}</dt>
          <dd data-status-theme>Light</dd>
          <dt>{s.rows.content}</dt>
          <dd data-status-content>…</dd>
          <dt>{s.rows.stack}</dt>
          <dd>Astro {BUILD.astro} · Payload CMS · Vercel</dd>
        </dl>
      </section>

      <section
        id="status-panel-config"
        role="tabpanel"
        aria-labelledby="status-tab-config"
        data-status-panel="config"
        hidden
      >
        <label class="config-search">
          <span aria-hidden="true">⌕</span>
          <span class="sr-only">{s.searchSettings}</span>
          <input
            type="search"
            placeholder={s.searchPlaceholder}
            autocomplete="off"
            spellcheck="false"
            data-config-search
          />
        </label>
        <ul class="config-list" aria-label={s.title} data-config-list>
          {
            settings.map((setting) => (
              <li data-config-item data-config-label={setting.search}>
                <button
                  type="button"
                  class="config-row"
                  data-config={setting.id}
                  data-next-href={setting.id === 'language' ? localizePath(nextLocale, current) : undefined}
                  title={setting.hint}
                >
                  <span class="config-cursor" aria-hidden="true">❯</span>
                  <span class="config-label">{setting.label}</span>
                  <span class="config-value" data-config-value>
                    {setting.id === 'language' && `${LOCALE_LABEL[locale]} (${LOCALE_NAME[locale]}) `}
                    {(setting.id === 'language' || setting.id === 'reset') && <span aria-hidden="true">›</span>}
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-base-content/65" data-config-empty hidden>{s.noMatch}</p>
        <p class="mt-3 text-base-content/65">{s.savedLocally}</p>
      </section>

      <section id="status-panel-keys" role="tabpanel" aria-labelledby="status-tab-keys" data-status-panel="keys" hidden>
        <dl class="status-grid">
          {
            keys.map(([key, action]) => (
              <>
                <dt>
                  <kbd class="kbd kbd-sm font-mono">{key}</kbd>
                </dt>
                <dd>{action}</dd>
              </>
            ))
          }
        </dl>
      </section>
    </div>

    <div class="flex items-center gap-4 border-t border-base-300 px-5 py-2.5 text-xs text-base-content/65">
      <span class="min-w-0 truncate" data-status-hint>{s.client.hintTabs}</span>
      <form method="dialog" class="ms-auto">
        <button class="btn btn-ghost btn-xs font-mono" aria-label={s.close}>✕</button>
      </form>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button tabindex="-1">{s.keys.close}</button>
  </form>
</dialog>

<script>
  import type { StatusText } from '@/lib/i18n'

  type Win = Window & {
    __openStatus?: () => void
    __toggleTheme?: () => void
    __toggleView?: () => void
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-status-dialog]')

  // Changing the language loads another page (and Reset reloads this one), so
  // the panel would vanish. Remember the row in sessionStorage and reopen on it.
  const REOPEN_KEY = 'athena-status-reopen'
  const session = {
    take(): string | null {
      try {
        const value = window.sessionStorage.getItem(REOPEN_KEY)
        window.sessionStorage.removeItem(REOPEN_KEY)
        return value
      } catch {
        return null
      }
    },
    put(value: string) {
      try {
        window.sessionStorage.setItem(REOPEN_KEY, value)
      } catch {
        /* storage blocked: the panel just stays closed after the reload */
      }
    },
  }

  // Browser-only settings; the attributes are applied before paint in Layout.
  const store = {
    get(key: string): string | null {
      try {
        return window.localStorage.getItem(key)
      } catch {
        return null
      }
    },
    set(key: string, value: string | null) {
      try {
        if (value === null) window.localStorage.removeItem(key)
        else window.localStorage.setItem(key, value)
      } catch {
        /* storage blocked: the change lasts for this page only */
      }
    },
  }

  if (dialog) {
    const root = document.documentElement
    // Page-language strings, rendered by the server (see statusText()).
    const T = JSON.parse(dialog.dataset.strings ?? '{}') as StatusText['client']
    const fill = (template: string, n: number) => template.replace('{n}', String(n))
    const win = window as Win
    const tabs = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-status-tab]'))
    const panels = Array.from(dialog.querySelectorAll<HTMLElement>('[data-status-panel]'))
    const rendered = dialog.querySelector<HTMLTimeElement>('[data-status-rendered]')
    const content = dialog.querySelector<HTMLElement>('[data-status-content]')
    const hint = dialog.querySelector<HTMLElement>('[data-status-hint]')
    const search = dialog.querySelector<HTMLInputElement>('[data-config-search]')
    const items = Array.from(dialog.querySelectorAll<HTMLElement>('[data-config-item]'))
    const empty = dialog.querySelector<HTMLElement>('[data-config-empty]')
    const reducedByOS = window.matchMedia('(prefers-reduced-motion: reduce)')
    let counted = false

    const HINTS: Record<string, string> = {
      status: T.hintTabs,
      config: T.hintConfig,
      keys: T.hintTabs,
    }

    const currentTab = () =>
      tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')?.dataset.statusTab ?? 'status'

    const rows = () =>
      items
        .filter((item) => !item.hidden)
        .map((item) => item.querySelector<HTMLButtonElement>('[data-config]'))
        .filter((row): row is HTMLButtonElement => row !== null)

    const setActive = (row: HTMLElement | undefined, focus = true) => {
      for (const other of dialog.querySelectorAll('[data-config]')) other.removeAttribute('data-active')
      if (!row) return
      row.setAttribute('data-active', '')
      if (focus) row.focus()
    }

    const showTab = (id: string, focus = false) => {
      for (const tab of tabs) {
        const selected = tab.dataset.statusTab === id
        tab.setAttribute('aria-selected', String(selected))
        tab.tabIndex = selected ? 0 : -1
        if (selected && focus) tab.focus()
      }
      for (const panel of panels) panel.hidden = panel.dataset.statusPanel !== id
      if (hint) hint.textContent = HINTS[id] ?? HINTS.status ?? ''
      if (id === 'config') setActive(rows()[0], focus)
    }

    const ago = (iso: string): string => {
      const seconds = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 1000))
      if (seconds < 10) return T.justNow
      if (seconds < 90) return fill(T.secondsAgo, seconds)
      const minutes = Math.round(seconds / 60)
      if (minutes < 90) return fill(T.minutesAgo, minutes)
      const hours = Math.round(minutes / 60)
      if (hours < 36) return fill(T.hoursAgo, hours)
      return fill(T.daysAgo, Math.round(hours / 24))
    }

    const motionReduced = () => {
      const stored = root.getAttribute('data-motion')
      return stored ? stored === 'reduce' : reducedByOS.matches
    }

    // Values change while the panel is open, so read them from the page.
    const refresh = () => {
      const view = root.getAttribute('data-view') === 'modern' ? 'ADE' : 'CLI'
      const theme = root.getAttribute('data-theme') === 'dark' ? 'Dark mode' : 'Light mode'
      const values: Record<string, string> = {
        view,
        theme,
        motion: String(motionReduced()),
        keys: String(root.getAttribute('data-keys') !== 'off'),
      }
      for (const row of dialog.querySelectorAll<HTMLElement>('[data-config]')) {
        const value = values[row.dataset.config ?? '']
        const cell = row.querySelector('[data-config-value]')
        if (value !== undefined && cell) cell.textContent = value
        const label = row.querySelector('.config-label')?.textContent ?? ''
        const shown = cell?.textContent?.replace('›', '').trim() ?? ''
        row.setAttribute('aria-label', shown ? `${label}: ${shown}. ${T.changeHint}` : label)
      }
      const viewCell = dialog.querySelector('[data-status-view]')
      const themeCell = dialog.querySelector('[data-status-theme]')
      if (viewCell) viewCell.textContent = view
      if (themeCell) themeCell.textContent = theme.replace(' mode', '')
      if (rendered) rendered.textContent = ago(rendered.dateTime)
    }

    const change = (row: HTMLElement) => {
      switch (row.dataset.config) {
        case 'view':
          win.__toggleView?.()
          break
        case 'theme':
          win.__toggleTheme?.()
          break
        case 'language':
          if (!row.dataset.nextHref) return
          session.put('language')
          window.location.href = row.dataset.nextHref
          return
        case 'motion': {
          const next = motionReduced() ? 'full' : 'reduce'
          root.setAttribute('data-motion', next)
          store.set('athena-motion', next)
          break
        }
        case 'keys': {
          const off = root.getAttribute('data-keys') !== 'off'
          if (off) root.setAttribute('data-keys', 'off')
          else root.removeAttribute('data-keys')
          store.set('athena-keys', off ? 'off' : null)
          break
        }
        case 'reset': {
          for (const key of ['athena-view', 'athena-motion', 'athena-keys', 'payload-theme']) store.set(key, null)
          session.put('reset')
          window.location.reload()
          return
        }
      }
      refresh()
    }

    const filter = () => {
      const query = (search?.value ?? '').trim().toLowerCase()
      let shown = 0
      for (const item of items) {
        const match = !query || (item.dataset.configLabel ?? '').includes(query)
        item.hidden = !match
        if (match) shown += 1
      }
      if (empty) empty.hidden = shown > 0
      setActive(rows()[0], false)
    }

    // Post and page counts come from the popup search index (cached at Vercel).
    const count = async () => {
      if (counted || !content) return
      counted = true
      try {
        const res = await fetch(dialog.dataset.indexUrl ?? '/search-index.json')
        if (!res.ok) throw new Error(String(res.status))
        const index = (await res.json()) as { posts: unknown[]; pages: unknown[] }
        const count = ([one, many]: string[], n: number) => fill((n === 1 ? one : many) ?? '', n)
        content.textContent = `${count(T.posts, index.posts.length)} · ${count(T.pages, index.pages.length)}`
      } catch {
        counted = false
        content.textContent = T.unavailable
      }
    }

    // With a Config row id, opens on the Config tab with that row selected.
    const open = (configRow?: string) => {
      if (dialog.open) return
      if (search) search.value = ''
      filter()
      refresh()
      const row = configRow
        ? dialog.querySelector<HTMLElement>(`[data-config="${CSS.escape(configRow)}"]`)
        : null
      showTab(row ? 'config' : 'status')
      dialog.showModal()
      if (row) setActive(row)
      else tabs[0]?.focus()
      void count()
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => showTab(tab.dataset.statusTab ?? 'status'))
    }

    search?.addEventListener('input', filter)

    dialog.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null
      const inSearch = target === search
      const tab = currentTab()

      if (tab === 'config' && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
        const list = rows()
        const active = list.findIndex((row) => row.hasAttribute('data-active'))
        event.preventDefault()
        if (inSearch) {
          if (event.key === 'ArrowDown') setActive(list[Math.max(active, 0)])
          return
        }
        if (event.key === 'ArrowUp' && active <= 0) {
          search?.focus()
          return
        }
        const next = event.key === 'ArrowDown' ? Math.min(active + 1, list.length - 1) : active - 1
        setActive(list[next])
        return
      }

      if (tab === 'config' && inSearch && event.key === 'Enter') {
        event.preventDefault()
        const row = rows().find((r) => r.hasAttribute('data-active'))
        if (row) change(row)
        return
      }

      // Typing on a row jumps to the search box.
      if (tab === 'config' && !inSearch && search && event.key.length === 1 && event.key !== ' ' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        search.focus()
        return
      }

      if (inSearch) return
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return
      const index = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')
      const step = event.key === 'ArrowRight' ? 1 : -1
      const next = tabs[(index + step + tabs.length) % tabs.length]
      if (!next) return
      event.preventDefault()
      showTab(next.dataset.statusTab ?? 'status', true)
    })

    dialog.addEventListener('click', (event) => {
      const row = (event.target as Element | null)?.closest<HTMLElement>('[data-config]')
      if (!row) return
      setActive(row, false)
      change(row)
    })

    dialog.addEventListener('focusin', (event) => {
      const row = (event.target as Element | null)?.closest<HTMLElement>('[data-config]')
      if (row) setActive(row, false)
    })

    document.addEventListener('click', (event) => {
      if (!(event.target as Element | null)?.closest('[data-status-open]')) return
      event.preventDefault()
      open()
    })

    // The `s` shortcut (Layout) and `/status` in the popup search call this.
    win.__openStatus = () => open()

    const reopen = () => {
      const row = session.take()
      if (row) open(row)
    }
    const doc = document as Document & { prerendering?: boolean }
    if (doc.prerendering) document.addEventListener('prerenderingchange', reopen, { once: true })
    else reopen()
  }
</script>
