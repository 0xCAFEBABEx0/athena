---
/**
 * Pages are cached until the next publish, so "2 hours ago" cannot be baked
 * into the HTML. The server writes the date; this script rewrites every
 * <time data-relative> in the page language once the page is shown.
 */
---

<script>
  const UNITS: [Intl.RelativeTimeFormatUnit, number][] = [
    ['year', 365 * 86400],
    ['month', 30 * 86400],
    ['week', 7 * 86400],
    ['day', 86400],
    ['hour', 3600],
    ['minute', 60],
  ]

  // Thread-list style: "2m", "5h", "3d", then "Oct 30" within a year, then
  // "2y", so the column stays narrow in every language.
  const compact = (lang: string, at: number, now: number): string => {
    const seconds = Math.max(0, Math.round((now - at) / 1000))
    const unit = (value: number, name: 'minute' | 'hour' | 'day' | 'year') =>
      new Intl.NumberFormat(lang, { style: 'unit', unit: name, unitDisplay: 'narrow' }).format(value)
    if (seconds < 3600) return unit(Math.max(1, Math.floor(seconds / 60)), 'minute')
    if (seconds < 86400) return unit(Math.floor(seconds / 3600), 'hour')
    if (seconds < 7 * 86400) return unit(Math.floor(seconds / 86400), 'day')
    if (seconds < 365 * 86400) {
      return new Intl.DateTimeFormat(lang, { month: 'short', day: 'numeric' }).format(new Date(at))
    }
    return unit(Math.floor(seconds / (365 * 86400)), 'year')
  }

  const render = () => {
    const lang = document.documentElement.lang || 'en'
    const rtf = new Intl.RelativeTimeFormat(lang, { numeric: 'auto' })
    const now = Date.now()
    document.querySelectorAll<HTMLTimeElement>('time[data-relative]').forEach((el) => {
      const at = Date.parse(el.dateTime)
      if (Number.isNaN(at)) return
      if (el.dataset.relative === 'compact') {
        el.title = el.title || el.textContent?.trim() || ''
        el.textContent = compact(lang, at, now)
        return
      }
      const seconds = Math.round((at - now) / 1000)
      const unit = UNITS.find(([, size]) => Math.abs(seconds) >= size)
      el.title = el.title || el.textContent?.trim() || ''
      el.textContent = unit
        ? rtf.format(Math.round(seconds / unit[1]), unit[0])
        : rtf.format(0, 'minute')
    })
  }

  render()
  document.addEventListener('astro:page-load', render)
</script>
