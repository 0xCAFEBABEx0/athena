---
import { dict, localeOf } from '@/lib/i18n'

/**
 * Light/dark toggle, persisted in localStorage under the same
 * 'payload-theme' key the cms admin uses (see the theme script in Layout).
 * The label names the theme you switch to: `[dark]` in the CLI header,
 * "Dark" in the modern sidebar, a moon / sun icon in the modern phone top bar.
 * CSS picks the label from data-theme, so any number of toggles stay in sync.
 */
type Props = {
  variant?: 'flag' | 'word' | 'icon'
  class?: string
}

const { variant = 'flag', class: className } = Astro.props
const t = dict(localeOf(Astro))
const toDark = variant === 'flag' ? '[dark]' : t.darkWord
const toLight = variant === 'flag' ? '[light]' : t.lightWord
---

{
  variant === 'icon' ? (
    <button type="button" class:list={['topbar-icon btn btn-ghost btn-square', className]} data-theme-toggle>
      <svg class="theme-when-light" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
      </svg>
      <svg class="theme-when-dark" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
      </svg>
      <span class="sr-only theme-when-light">{t.toDark}</span>
      <span class="sr-only theme-when-dark">{t.toLight}</span>
    </button>
  ) : (
    <button
      type="button"
      class:list={[
        'btn btn-ghost btn-sm font-normal text-base-content/65 hover:text-base-content',
        variant === 'flag' ? 'min-h-11 px-2 font-mono' : 'px-2 font-mono text-xs',
        className,
      ]}
      data-theme-toggle
    >
      <span class="theme-when-light" aria-hidden="true">{toDark}</span>
      <span class="theme-when-dark" aria-hidden="true">{toLight}</span>
      <span class="sr-only theme-when-light">{t.toDark}</span>
      <span class="sr-only theme-when-dark">{t.toLight}</span>
    </button>
  )
}

<script>
  const KEY = 'payload-theme'

  const toggle = () => {
    const root = document.documentElement
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
    try {
      window.localStorage.setItem(KEY, next)
    } catch {
      /* private mode: the theme still switches for this page */
    }
    root.setAttribute('data-theme', next)
  }

  ;(window as Window & { __toggleTheme?: () => void }).__toggleTheme = toggle
  document.addEventListener('click', (event) => {
    if ((event.target as Element | null)?.closest('[data-theme-toggle]')) toggle()
  })
</script>
