---
/**
 * CLI-view welcome box on the home page: Hoo the owl (a button: clicking
 * wakes it and it says a tip), the welcome line, name, intro and a
 * `posts / updated / langs / links` list. At phone width the owl shrinks to
 * 3 px per pixel and sits beside the name.
 *
 * From 48rem the box splits in two, like an agent CLI's startup screen: the
 * owl and the profile centered on the left, and on the right "Tips for
 * getting started" (clickable commands) and "Recent activity" (newest posts,
 * pushes and releases, relative times).
 *
 * Settings come from the Site global (`banner`); the ADE view keeps its own
 * intro card.
 */
import { LOCALES, LOCALE_LABEL, dict, localeOf } from '@/lib/i18n'
import { formatDate } from '@/lib/format'
import { owlPaths, OWL_HEIGHT, OWL_WIDTH, type OwlFrame } from '@/lib/owl'
import type { SiteData } from '@/lib/site'
import RelativeTimes from '@/components/work/RelativeTimes.astro'
import type { BannerActivity } from '@/lib/activity'

type Props = {
  site: SiteData
  totalPosts: number
  updated: string | null
  activity: BannerActivity[]
}

const { site, totalPosts, updated, activity } = Astro.props
const t = dict(localeOf(Astro))
const tips = site.banner.tips.length > 0 ? site.banner.tips : t.bannerTips
const frames: OwlFrame[] = ['sleep', 'awake', 'wave', 'wink']
const name = site.authorName || site.siteName
const kindLabel = { post: t.activityPost, release: t.activityRelease, push: t.activityPush }
const commands = [
  { cmd: 'search', key: '/', label: t.bannerCmdSearch },
  { cmd: 'status', key: '/status', label: t.bannerCmdStatus },
  { cmd: 'view', key: 'v', label: t.bannerCmdView },
  { cmd: 'theme', key: 't', label: t.bannerCmdTheme },
  // Keys only: nothing to run on a click.
  { cmd: null, key: 'j k', label: t.shortcutMove },
  { cmd: null, key: 'h l', label: t.shortcutSection },
] as const
---

<section
  class:list={['cli-banner cli-only', { 'has-owl': site.banner.mascot }]}
  aria-labelledby="banner-name"
  data-owl-banner
  data-tips={JSON.stringify(tips)}
>
  {
    site.banner.mascot && (
      <div class="cli-banner-owl">
        <button type="button" class="owl-button" aria-label={t.bannerWake} aria-pressed="false" data-owl-button>
          <svg
            class="owl"
            viewBox={`0 0 ${OWL_WIDTH} ${OWL_HEIGHT}`}
            shape-rendering="crispEdges"
            aria-hidden="true"
            data-owl-frame="sleep"
          >
            {frames.map((frame) => (
              <g data-frame={frame}>
                {owlPaths(frame).map((path) => (
                  <path class={`owl-${path.color}`} d={path.d} />
                ))}
              </g>
            ))}
          </svg>
          <span class="owl-zz" aria-hidden="true">
            z<span>Z</span>
          </span>
        </button>
        <span class="owl-hint" aria-hidden="true">{t.bannerHint}</span>
      </div>
    )
  }
  <div class="owl-tip-live" aria-live="polite">
    <p class="owl-tip" hidden data-owl-tip></p>
  </div>
  <div class="cli-banner-head">
    {site.welcome && <p class="cli-banner-welcome"># {site.welcome}</p>}
    <h1 id="banner-name" class="heading-display">{name}</h1>
  </div>
  <div class="cli-banner-body">
    {site.intro && <p class="cli-banner-intro">{site.intro}</p>}
    <dl class="cli-banner-facts">
      <dt>{t.bannerPosts}</dt>
      <dd>{totalPosts}</dd>
      {
        updated && (
          <>
            <dt>{t.bannerUpdated}</dt>
            <dd>{updated}</dd>
          </>
        )
      }
      <dt>{t.bannerLangs}</dt>
      <dd>{LOCALES.map((code) => LOCALE_LABEL[code].toLowerCase()).join(' · ')}</dd>
      {
        site.socialLinks.length > 0 && (
          <>
            <dt>{t.bannerLinks}</dt>
            <dd class="cli-banner-links">
              {site.socialLinks.map((link) => (
                <a class="link-term" href={link.url} rel="me noopener">
                  {link.label}
                </a>
              ))}
            </dd>
          </>
        )
      }
    </dl>
  </div>
  <div class="cli-banner-side">
    <section aria-labelledby="banner-start">
      <h2 id="banner-start" class="cli-banner-side-title">{t.bannerStart}</h2>
      <ul class="cli-banner-cmds">
        {
          commands.map((command) => (
            <li>
              {command.cmd ? (
                <button type="button" class="cli-banner-cmd" data-banner-cmd={command.cmd}>
                  <kbd class="kbd kbd-sm">{command.key}</kbd>
                  <span>{command.label}</span>
                </button>
              ) : (
                <span class="cli-banner-cmd">
                  <kbd class="kbd kbd-sm">{command.key}</kbd>
                  <span>{command.label}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="banner-activity">
      <h2 id="banner-activity" class="cli-banner-side-title">{t.bannerActivity}</h2>
      {
        activity.length > 0 ? (
          <ul class="cli-banner-activity">
            {activity.map((item) => (
              <li>
                <time datetime={item.date} data-relative="compact">
                  {formatDate(item.date)}
                </time>
                <span class="cli-banner-kind">{kindLabel[item.kind]}</span>
                <a class="cli-banner-activity-link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="cli-banner-empty">{t.bannerNoActivity}</p>
        )
      }
    </section>
  </div>
</section>
<RelativeTimes />

<script>
  // Wake sequence: wave and look up three times, wink, stay awake (300 ms a
  // frame). Clicking again puts Hoo back to sleep; each wake says the next tip.
  const SEQUENCE = ['wave', 'awake', 'wave', 'awake', 'wave', 'awake', 'wink', 'awake'] as const
  const FRAME_MS = 300

  const reduceMotion = () => {
    const setting = document.documentElement.getAttribute('data-motion')
    if (setting) return setting === 'reduce'
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches
  }

  // "Tips for getting started": each line runs what it shows.
  type Commands = {
    __openSearch?: () => void
    __openStatus?: () => void
    __toggleView?: () => void
    __toggleTheme?: () => void
  }
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-banner-cmd]')) {
    button.addEventListener('click', () => {
      const win = window as unknown as Commands
      const run = {
        search: win.__openSearch,
        status: win.__openStatus,
        view: win.__toggleView,
        theme: win.__toggleTheme,
      }[button.dataset.bannerCmd ?? '']
      run?.()
    })
  }

  for (const banner of document.querySelectorAll<HTMLElement>('[data-owl-banner]')) {
    const button = banner.querySelector<HTMLButtonElement>('[data-owl-button]')
    const svg = banner.querySelector<SVGElement>('[data-owl-frame]')
    const tip = banner.querySelector<HTMLElement>('[data-owl-tip]')
    if (!button || !svg || !tip) continue

    let tips: string[] = []
    try {
      tips = JSON.parse(banner.dataset.tips ?? '[]') as string[]
    } catch {
      tips = []
    }
    let next = 0
    let timer: number | undefined

    const show = (frame: string) => svg.setAttribute('data-owl-frame', frame)
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer)
      timer = undefined
    }

    button.addEventListener('click', () => {
      stop()
      if (banner.hasAttribute('data-awake')) {
        banner.removeAttribute('data-awake')
        button.setAttribute('aria-pressed', 'false')
        show('sleep')
        tip.hidden = true
        tip.textContent = ''
        return
      }
      banner.setAttribute('data-awake', '')
      button.setAttribute('aria-pressed', 'true')
      const line = tips.length > 0 ? tips[next % tips.length] : ''
      next += 1
      tip.textContent = line ?? ''
      tip.hidden = !line
      if (reduceMotion()) {
        show('awake')
        return
      }
      let step = 0
      show(SEQUENCE[0])
      timer = window.setInterval(() => {
        step += 1
        const frame = SEQUENCE[step]
        if (!frame) {
          stop()
          return
        }
        show(frame)
      }, FRAME_MS)
    })
  }
</script>
