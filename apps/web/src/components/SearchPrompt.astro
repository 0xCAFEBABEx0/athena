---
import { aiModes } from '@/lib/ai'
import { aiText } from '@/lib/ai-text'
import { dict, localeOf, localizePath } from '@/lib/i18n'

/**
 * Keyword search box. CLI view: an agent CLI's input line (`❯ …`). Modern
 * view: the chat composer pinned to the bottom of the column. Either way it
 * submits to /search; the popup search is the "/" and ⌘K shortcut. Slash
 * commands work here too: typing "/s…" suggests /status, and Enter opens the
 * status panel instead of searching. Children (the /search page's mode
 * switch) render under the box, inside the pinned composer in the modern view.
 *
 * With AI search on (docs/AI_SEARCH.md), Enter opens /search by meaning
 * (?mode=meaning), and typing offers an "Ask Hoo" row that opens the question
 * in Ask AI. Nothing is asked until the visitor presses Enter or picks the row.
 * The /search page passes assist={false}: it has its own tabs.
 */
type Props = {
  value?: string
  autofocus?: boolean
  class?: string
  assist?: boolean
}

const locale = localeOf(Astro)
const t = dict(locale)
const ai = aiText(locale)
const { value = '', autofocus = false, class: className, assist = true } = Astro.props
const modes = assist ? aiModes() : []
const meaning = modes.includes('meaning')
const ask = modes.includes('ask')
---

<div class:list={['search-prompt', className]} data-search-prompt>
  <form action={localizePath(locale, '/search')} method="get" role="search" class="relative font-mono">
    <div class="prompt-commands" role="listbox" aria-label={t.statusCommand} hidden data-prompt-commands>
      <button type="button" class="search-hit font-mono" role="option" aria-selected="true" data-prompt-command="/status">
        <span class="search-hit-icon" aria-hidden="true">❯</span>
        <span class="min-w-0 flex-1 truncate text-left">/status</span>
        <span class="hidden shrink-0 text-xs text-base-content/65 sm:inline">{t.statusCommand}</span>
        <span class="search-hit-enter" aria-hidden="true">↵</span>
      </button>
      {
        ask && (
          <button type="button" class="search-hit search-hit-ask" role="option" aria-selected="false" hidden data-prompt-ask>
            <span class="search-hit-icon" aria-hidden="true">✦</span>
            <span class="min-w-0 flex-1 truncate text-left">
              <span class="font-semibold">{ai.askHoo}</span> <span class="text-base-content/65" data-prompt-ask-text />
            </span>
            <span class="hidden shrink-0 text-xs text-base-content/65 sm:inline">{ai.askHooHint}</span>
            <span class="search-hit-enter" aria-hidden="true">↵</span>
          </button>
        )
      }
    </div>
    {meaning && <input type="hidden" name="mode" value="meaning" />}
    <label
      class="search-prompt-box input input-lg h-12 w-full gap-3 bg-base-200 font-mono text-sm focus-within:border-primary focus-within:outline-none"
    >
      <span class="cli-only text-primary" aria-hidden="true">❯</span>
      <span class="sr-only">{t.search}</span>
      <input
        type="search"
        name="q"
        value={value}
        placeholder={ask ? t.searchPlaceholderAsk : t.searchPlaceholder}
        autocomplete="off"
        autofocus={autofocus}
        data-search-input
        class="grow"
      />
      <span class="cli-only hidden items-center gap-1 text-xs text-base-content/65 sm:flex">
        <kbd class="kbd kbd-sm">/</kbd>
        {t.searchHint} · <kbd class="kbd kbd-sm">Enter</kbd>
        {t.searchRun}
      </span>
      <button type="submit" class="modern-only modern-send" aria-label={t.searchSubmit}>↑</button>
    </label>
  </form>
  {/* Extra controls that travel with the box (the search modes on /search). */}
  <slot />
  <p class="modern-only modern-hint font-mono">
    / {t.shortcutSearch} · j/k {t.shortcutMove} · h/l {t.shortcutSection} · g h {t.shortcutHome} · t {t.shortcutTheme} · v {t.shortcutView} · s {t.shortcutStatus}
  </p>
</div>

<script>
  // Slash commands in the inline prompt, mirroring the popup search.
  type StatusWindow = Window & { __openStatus?: () => void }
  const COMMANDS = ['/status'] as const

  const matchCommand = (value: string) => {
    const query = value.trim().toLowerCase()
    if (!query.startsWith('/')) return null
    return COMMANDS.find((name) => name.startsWith(query)) ?? null
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-search-prompt]')) {
    const form = root.querySelector('form')
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')
    const menu = root.querySelector<HTMLElement>('[data-prompt-commands]')
    const command = root.querySelector<HTMLElement>('[data-prompt-command]')
    // "Ask Hoo" (only with Ask AI on): opens the question in /search's Ask AI.
    const askRow = root.querySelector<HTMLButtonElement>('[data-prompt-ask]')
    const askText = root.querySelector<HTMLElement>('[data-prompt-ask-text]')
    if (!form || !input || !menu || !command) continue

    const question = () => input.value.replace(/\s+/g, ' ').trim()
    const selectAsk = (on: boolean) => askRow?.setAttribute('aria-selected', String(on))
    const ask = () => {
      const q = question()
      if (!q) return
      const url = new URL(form.action)
      url.searchParams.set('q', q)
      url.searchParams.set('mode', 'ask')
      window.location.href = url.href
    }

    const update = () => {
      const slash = matchCommand(input.value) !== null
      command.hidden = !slash
      if (askRow) {
        const q = question()
        askRow.hidden = slash || !q || q.startsWith('/')
        if (askText) askText.textContent = `“${q}”`
        if (askRow.hidden) selectAsk(false)
      }
      menu.hidden = command.hidden && (askRow?.hidden ?? true)
      // Open downward when the prompt sits near the top (e.g. the /search page).
      if (!menu.hidden) menu.toggleAttribute('data-below', form.getBoundingClientRect().top < menu.offsetHeight + 72)
    }
    const run = () => {
      input.value = ''
      menu.hidden = true
      input.blur()
      ;(window as StatusWindow).__openStatus?.()
    }

    input.addEventListener('input', update)
    input.addEventListener('focus', update)
    input.addEventListener('blur', () => {
      // Let a click on the suggestion land before hiding it.
      setTimeout(() => {
        if (!root.contains(document.activeElement)) menu.hidden = true
      }, 120)
    })
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.hidden = true
        selectAsk(false)
      } else if (askRow && !askRow.hidden && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
        // ↓ picks "Ask Hoo", ↑ goes back to a plain search.
        event.preventDefault()
        selectAsk(event.key === 'ArrowDown')
      }
    })
    if (askRow) {
      askRow.addEventListener('mousedown', (event) => event.preventDefault())
      askRow.addEventListener('click', ask)
    }
    for (const button of menu.querySelectorAll<HTMLButtonElement>('[data-prompt-command]')) {
      button.addEventListener('mousedown', (event) => event.preventDefault())
      button.addEventListener('click', run)
    }
    form.addEventListener('submit', (event) => {
      if (askRow && !askRow.hidden && askRow.getAttribute('aria-selected') === 'true') {
        event.preventDefault()
        ask()
        return
      }
      if (matchCommand(input.value) === null || !(window as StatusWindow).__openStatus) return
      event.preventDefault()
      run()
    })
  }
</script>
