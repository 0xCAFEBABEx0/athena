---
import { linkHref, type CMSLinkData } from '@/lib/links'

type Props = CMSLinkData & {
  appearance?: 'inline' | 'link' | 'nav' | 'default' | 'outline' | null
  size?: 'sm' | 'default' | 'lg' | 'clear' | null
  class?: string
  /** Mark the link as the current page (nav). */
  current?: boolean
}

const {
  appearance: appearanceProp,
  size,
  label,
  newTab,
  class: className,
  current,
  ...link
} = Astro.props
const appearance = appearanceProp ?? 'inline'

const href = linkHref({ ...link, label, newTab })

const sizeClasses: Record<string, string> = {
  sm: 'btn-sm',
  default: '',
  lg: 'btn-lg',
  clear: '',
}

const appearanceClasses: Record<string, string> = {
  inline: '',
  link: 'link-term text-sm',
  nav: 'inline-flex min-h-11 items-center px-2 font-mono text-sm no-underline text-base-content/60 hover:text-base-content aria-[current=page]:text-base-content aria-[current=page]:font-semibold',
  default: 'btn btn-primary btn-sm font-mono font-normal',
  outline: 'btn btn-outline btn-sm border-base-300 font-mono font-normal hover:border-primary',
}

const isButton = appearance === 'default' || appearance === 'outline'
const classes = [
  appearanceClasses[appearance],
  isButton ? sizeClasses[size ?? 'default'] : '',
  className,
]
  .filter(Boolean)
  .join(' ')
---

{
  href && (
    <a
      href={href}
      class={classes || undefined}
      aria-current={current ? 'page' : undefined}
      target={newTab ? '_blank' : undefined}
      rel={newTab ? 'noopener noreferrer' : undefined}
    >
      {label}
      <slot />
    </a>
  )
}
