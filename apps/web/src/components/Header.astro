---
import type { Header } from '@athena/shared/payload-types'

import CMSLink from '@/components/CMSLink.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { getGlobal } from '@/lib/cms'
import { linkHref, type CMSLinkData } from '@/lib/links'
import type { SiteData } from '@/lib/site'

type Props = {
  site: SiteData
}

const { site } = Astro.props

let navItems: NonNullable<Header['navItems']> = []
try {
  const header = await getGlobal<Header>('header')
  navItems = header?.navItems || []
} catch (error) {
  // CMS outage must not 500 every page; Layout still renders without nav.
  console.error('[header] failed to load nav', error)
}

// Until nav is set up in the CMS, keep the two routes every visitor needs.
const fallbackNav: CMSLinkData[] = [
  { type: 'custom', url: '/', label: 'home' },
  { type: 'custom', url: '/posts', label: 'posts' },
]
const links: CMSLinkData[] = navItems.length > 0 ? navItems.map(({ link }) => link) : fallbackNav

const { pathname } = Astro.url
const isCurrent = (href: string | null): boolean => {
  if (!href || !href.startsWith('/')) return false
  if (href === '/') return pathname === '/'
  return pathname === href || pathname.startsWith(`${href}/`)
}
---

<header class="container flex flex-wrap items-center justify-between gap-x-4 pt-5">
  <a
    class="inline-flex min-h-11 items-center gap-2 font-mono text-sm font-semibold text-base-content no-underline"
    href="/"
  >
    <span class="text-primary" aria-hidden="true">❯_</span>{site.siteName}
  </a>
  <nav class="flex flex-wrap items-center" aria-label="メイン">
    {links.map((link) => <CMSLink {...link} appearance="nav" current={isCurrent(linkHref(link))} />)}
    <ThemeToggle />
  </nav>
</header>
