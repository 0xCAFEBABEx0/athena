---
type Props = {
  page: number
  totalPages: number
  class?: string
}

const { page, totalPages, class: className } = Astro.props

const pageHref = (n: number) => (n === 1 ? '/posts' : `/posts/page/${n}`)

// Current page with up to two neighbours on each side.
const first = Math.max(1, page - 2)
const last = Math.min(totalPages, page + 2)
const pages = Array.from({ length: last - first + 1 }, (_, i) => first + i)

const item = 'join-item btn btn-sm font-mono font-normal'
---

<nav class:list={['mt-8', className]} aria-label="ページ送り">
  <div class="join">
    {
      page > 1 ? (
        <a class:list={[item, 'btn-ghost']} href={pageHref(page - 1)} rel="prev">
          ← prev
        </a>
      ) : (
        <span class:list={[item, 'btn-disabled']} aria-disabled="true">
          ← prev
        </span>
      )
    }
    {
      pages.map((n) =>
        n === page ? (
          <a class:list={[item, 'btn-primary']} href={pageHref(n)} aria-current="page">
            {n}
          </a>
        ) : (
          <a class:list={[item, 'btn-ghost']} href={pageHref(n)}>
            {n}
          </a>
        ),
      )
    }
    {
      page < totalPages ? (
        <a class:list={[item, 'btn-ghost']} href={pageHref(page + 1)} rel="next">
          next →
        </a>
      ) : (
        <span class:list={[item, 'btn-disabled']} aria-disabled="true">
          next →
        </span>
      )
    }
  </div>
</nav>
