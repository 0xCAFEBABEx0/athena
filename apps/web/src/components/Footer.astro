---
import CMSLink from '@/components/CMSLink.astro'
import { getFooterNav } from '@/lib/nav'
import type { SiteData } from '@/lib/site'
import { localeOf, localizePath } from '@/lib/i18n'

type Props = {
  site: SiteData
}

const { site } = Astro.props
const locale = localeOf(Astro)

const navLinks = await getFooterNav(Astro.request, locale)

const path = Astro.originPathname === '/' ? '~' : `~${Astro.originPathname.replace(/\/$/, '')}`
const year = new Date().getFullYear()
---

<footer class="site-footer container mt-auto pb-8 pt-14">
  <div
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-base-300 pt-3.5 font-mono text-xs text-base-content/65"
  >
    <span class="inline-flex items-center gap-2">
      <span class="status status-success" aria-hidden="true"></span>
      <span>{site.siteName}</span>
      <span aria-hidden="true">·</span>
      <span>{path}</span>
    </span>
    <span class="inline-flex flex-wrap items-center gap-x-4 gap-y-1">
      {
        navLinks.map((link) => (
          <CMSLink class="text-base-content/65 no-underline hover:text-base-content" {...link} />
        ))
      }
      <a class="text-base-content/65 no-underline hover:text-base-content" href={localizePath(locale, '/rss.xml')}>rss</a>
      <span>© {year} {site.authorName || site.siteName}</span>
    </span>
  </div>
</footer>
