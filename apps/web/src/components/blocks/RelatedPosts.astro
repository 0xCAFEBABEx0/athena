---
import { dict, localeOf } from '@/lib/i18n'
import type { Post } from '@athena/shared/payload-types'

import PostList from '@/components/PostList.astro'
import Prompt from '@/components/Prompt.astro'

type Props = {
  docs?: Post[]
  class?: string
}

const t = dict(localeOf(Astro))
const { docs = [], class: className } = Astro.props
---

<section class={className} aria-labelledby="related-posts">
  <Prompt heading={t.related} count={docs.length} id="related-posts" />
  <PostList class="mt-1.5" posts={docs} />
</section>
