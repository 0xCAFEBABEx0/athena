{
  "name": "@athena/web",
  "version": "1.0.0",
  "description": "Athena web frontend (Astro), consuming the Payload CMS REST API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build && bun scripts/pin-bun-runtime.mjs && bun scripts/route-legacy-redirects.mjs",
    "preview": "bun --bun astro preview",
    "check": "astro check",
    "lint": "astro check",
    "test": "bun test src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.20",
    "@athena/shared": "workspace:*",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.3",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.7",
    "qs-esm": "^8.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
