# 1Password references for ./tf (op run --env-file). These are references,
# not secrets: change the vault/item/field names to match yours, and keep
# every referenced field present (an empty cf_aig_token is fine until the
# AI Gateway has a token).
#
# API tokens the providers read from the environment.
VERCEL_API_TOKEN=op://Development/vercel-terraform/credential
CLOUDFLARE_API_TOKEN=op://Development/cloudflare-terraform/credential

# var.secrets (secret env var values for Vercel), one whole-value reference
# per key. ./tf turns every TF_SECRET_<key> into the JSON map TF_VAR_secrets
# (key in lower case) with jq, so any character in a value is safe.
TF_SECRET_revalidate_secret=op://Development/athena-terraform/revalidate_secret
TF_SECRET_preview_secret=op://Development/athena-terraform/preview_secret
TF_SECRET_payload_api_key=op://Development/athena-terraform/payload_api_key
TF_SECRET_payload_secret=op://Development/athena-terraform/payload_secret
TF_SECRET_cron_secret=op://Development/athena-terraform/cron_secret
TF_SECRET_web_protection_bypass=op://Development/athena-terraform/web_protection_bypass
TF_SECRET_cms_protection_bypass=op://Development/athena-terraform/cms_protection_bypass
TF_SECRET_github_token=op://Development/athena-github-repo-read/credential
TF_SECRET_voyage_api_key=op://Development/athena-terraform/voyage_api_key
TF_SECRET_cf_aig_token=op://Development/athena-terraform/cf_aig_token
