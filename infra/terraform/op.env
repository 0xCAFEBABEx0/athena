# 1Password references for ./tf (op run --env-file). These are references,
# not secrets: change the vault/item/field names to match yours, and keep
# every referenced field present (an empty cf_aig_token is fine until the
# AI Gateway has a token).
#
# API tokens the providers read from the environment.
VERCEL_API_TOKEN=op://Development/terraform-vercel/credential
CLOUDFLARE_API_TOKEN=op://Development/terraform-cloudflare/credential

# var.secrets (secret env var values for Vercel) as one JSON map. op run
# resolves the {{ op://... }} templates inside the value; it must stay on
# one line (inner quotes are kept as they are). The values are put into JSON
# as is, so a secret must not contain " or \.
TF_VAR_secrets={"revalidate_secret":"{{ op://Development/athena-terraform/revalidate_secret }}","preview_secret":"{{ op://Development/athena-terraform/preview_secret }}","payload_api_key":"{{ op://Development/athena-terraform/payload_api_key }}","payload_secret":"{{ op://Development/athena-terraform/payload_secret }}","cron_secret":"{{ op://Development/athena-terraform/cron_secret }}","web_protection_bypass":"{{ op://Development/athena-terraform/web_protection_bypass }}","cms_protection_bypass":"{{ op://Development/athena-terraform/cms_protection_bypass }}","github_token":"{{ op://Development/athena-terraform/github_token }}","voyage_api_key":"{{ op://Development/athena-terraform/voyage_api_key }}","cf_aig_token":"{{ op://Development/athena-terraform/cf_aig_token }}"}
