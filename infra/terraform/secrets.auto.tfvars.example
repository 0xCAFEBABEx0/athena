# Copy to secrets.auto.tfvars (git-ignored) and fill in, or export
# TF_VAR_secrets='{...}' instead. Never commit the real file.
secrets = {
  revalidate_secret       = "" # shared by athena-web and athena-cms
  preview_secret          = "" # shared by athena-web and athena-cms
  payload_api_key         = "" # web-frontend service account key (CMS database)
  payload_secret          = "" # changing it signs everyone out of the admin
  cron_secret             = ""
  web_protection_bypass   = "" # athena-web Protection Bypass for Automation
  github_token_production = ""
  github_token_preview    = ""
}
